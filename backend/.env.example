# Salin file ini menjadi ".env" lalu isi dengan nilai milikmu sendiri.
# JANGAN PERNAH commit file ".env" (berisi rahasia) ke Git/GitHub.

# Port server backend
PORT=4000
NODE_ENV=development

# Koneksi PostgreSQL
# Contoh lokal: postgresql://postgres:postgres@localhost:5432/klinik_db
# Contoh cloud (Supabase/Neon/Railway dll juga bisa dipakai sebagai Postgres murni):
# postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/klinik_db
DB_SSL=false

# Jumlah maksimum koneksi database per instance server.
# Untuk server biasa (lokal/Railway/Render) 10 sudah cukup.
# Untuk Vercel (serverless), gunakan angka kecil seperti 3-5 karena tiap
# instance function punya pool sendiri-sendiri - lihat DEPLOY_VERCEL.md.
DB_POOL_MAX=10

# Ganti dengan string acak yang panjang & rahasia (minimal 32 karakter).
# Bisa generate dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=9e0597c74373ef9f6ba090f0b4564d358db58979fa4e1080947f397522ace948d7e59334f4ec94b4e298fd091fa23eaf
JWT_EXPIRES_IN=2h

# URL frontend yang diizinkan mengakses API ini (untuk CORS)
FRONTEND_URL=http://localhost:5500
